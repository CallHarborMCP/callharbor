{
  "openapi": "3.1.0",
  "info": {
    "title": "CallHarbor REST API",
    "version": "1.0.0",
    "description": "Versioned REST API v1. Every route requires a signed-in browser session. Identity comes only from that session; no route accepts a user or owner identifier. Timestamps are UTC RFC 3339 with a Z suffix. Only operations listed here are implemented."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "sessionCookie": [] }],
  "paths": {
    "/api/v1/profiles": {
      "get": {
        "operationId": "getProfiles",
        "summary": "List the caller's AI and telephony profiles",
        "description": "Returns non-secret profile fields only. Endpoint URLs, headers, instructions and secret references are never returned. connectivity_status is always \"unknown\" until live provider checks ship (issue #81).",
        "responses": {
          "200": {
            "description": "Profiles owned by the caller",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfilesResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/calls": {
      "get": {
        "operationId": "listCalls",
        "summary": "List the caller's calls, newest first",
        "description": "Keyset pagination over (created_at DESC, id DESC). Pass next_cursor back as cursor to read the next page. Cursors are opaque.",
        "parameters": [
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 512 }, "description": "Opaque cursor from a previous next_cursor." },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } },
          { "name": "status", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/TechnicalStatus" } }
        ],
        "responses": {
          "200": {
            "description": "One page of calls",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CallsPage" } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/calls/{call_id}": {
      "get": {
        "operationId": "getCall",
        "summary": "Get one call owned by the caller",
        "description": "A call owned by another user is reported as not_found, the same as a missing call.",
        "parameters": [
          { "name": "call_id", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 64 } }
        ],
        "responses": {
          "200": {
            "description": "The call",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Call" } } }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "callharbor_session" }
    },
    "responses": {
      "Error": {
        "description": "Error envelope with a stable code",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "additionalProperties": false,
            "properties": {
              "code": { "$ref": "#/components/schemas/ErrorCode" },
              "message": { "type": "string" }
            }
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": ["unauthenticated", "forbidden", "insufficient_scope", "not_found", "invalid_input", "conflict", "internal"]
      },
      "TechnicalStatus": {
        "type": "string",
        "enum": ["queued", "initiating", "ringing", "active", "ending", "ended", "failed"]
      },
      "Timestamp": {
        "type": "string",
        "format": "date-time",
        "pattern": "Z$"
      },
      "AIProfile": {
        "type": "object",
        "required": ["id", "name", "protocol", "primary_transport", "model", "voice"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "protocol": { "type": "string", "enum": ["realtime_ws", "live_ws"] },
          "primary_transport": { "type": "string", "enum": ["websocket"] },
          "model": { "type": "string" },
          "voice": { "type": "string" }
        }
      },
      "TelephonyProfile": {
        "type": "object",
        "required": ["id", "name", "provider", "caller_number", "connectivity_status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "provider": { "type": "string", "enum": ["telnyx"] },
          "caller_number": { "type": "string" },
          "connectivity_status": { "type": "string", "enum": ["unknown"] }
        }
      },
      "ProfilesResponse": {
        "type": "object",
        "required": ["ai_profiles", "telephony_profiles"],
        "additionalProperties": false,
        "properties": {
          "ai_profiles": { "type": "array", "items": { "$ref": "#/components/schemas/AIProfile" } },
          "telephony_profiles": { "type": "array", "items": { "$ref": "#/components/schemas/TelephonyProfile" } }
        }
      },
      "CallDetails": {
        "type": "object",
        "required": ["max_duration_seconds", "record_requested", "record_effective"],
        "additionalProperties": false,
        "properties": {
          "outcome_reason_code": { "type": "string" },
          "max_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
          "record_requested": { "type": "boolean" },
          "record_effective": { "type": "boolean" }
        }
      },
      "Call": {
        "type": "object",
        "required": ["call_id", "telephony_profile_id", "ai_profile_id", "to_number", "technical_status", "task_outcome", "details", "transcript_available", "recording_available", "created_at", "updated_at", "ended_at"],
        "additionalProperties": false,
        "properties": {
          "call_id": { "type": "string" },
          "telephony_profile_id": { "type": "string" },
          "ai_profile_id": { "type": "string" },
          "to_number": { "type": "string" },
          "technical_status": { "$ref": "#/components/schemas/TechnicalStatus" },
          "task_outcome": { "type": ["string", "null"], "enum": ["success", "partial", "failed", "unknown", null] },
          "details": { "$ref": "#/components/schemas/CallDetails" },
          "transcript_available": { "type": "boolean" },
          "recording_available": { "type": "boolean" },
          "created_at": { "$ref": "#/components/schemas/Timestamp" },
          "updated_at": { "$ref": "#/components/schemas/Timestamp" },
          "ended_at": { "oneOf": [{ "$ref": "#/components/schemas/Timestamp" }, { "type": "null" }] }
        }
      },
      "CallsPage": {
        "type": "object",
        "required": ["calls", "next_cursor"],
        "additionalProperties": false,
        "properties": {
          "calls": { "type": "array", "items": { "$ref": "#/components/schemas/Call" } },
          "next_cursor": { "type": "string" }
        }
      }
    }
  }
}
