  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "callharbor_session"
      }
    },
    "responses": {
      "Error": {
        "description": "Error envelope with a stable code",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "unauthenticated",
          "forbidden",
          "insufficient_scope",
          "not_found",
          "invalid_input",
          "conflict",
          "unavailable",
          "internal"
        ]
      },
      "TechnicalStatus": {
        "type": "string",
        "enum": [
          "queued",
          "initiating",
          "ringing",
          "active",
          "ending",
          "ended",
          "failed"
        ]
      },
      "Timestamp": {
        "type": "string",
        "format": "date-time",
        "pattern": "Z$"
      },
      "AIProfile": {
        "type": "object",
        "required": [
          "id",
          "name",
          "protocol",
          "primary_transport",
          "model",
          "voice"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "realtime_ws",
              "live_ws"
            ]
          },
          "primary_transport": {
            "type": "string",
            "enum": [
              "websocket"
            ]
          },
          "model": {
            "type": "string"
          },
          "voice": {
            "type": "string"
          }
        }
      },
      "TelephonyProfile": {
        "type": "object",
        "required": [
          "id",
          "name",
          "provider",
          "caller_number",
          "connectivity_status",
          "connectivity_reason",
          "access"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "telnyx"
            ]
          },
          "caller_number": {
            "type": "string"
          },
          "connection_id": {
            "type": "string",
            "maxLength": 128,
            "description": "Telnyx Call Control application id that calls dial through. Required on create and update. Returned to the owner only; omitted when access is granted."
          },
          "connectivity_status": {
            "type": "string",
            "enum": [
              "unknown",
              "verified",
              "failed"
            ]
          },
          "connectivity_reason": {
            "type": "string",
            "description": "Fixed reason code from the last validation; empty when verified or unknown.",
            "enum": [
              "",
              "secrets_unavailable",
              "invalid_credentials",
              "application_not_found",
              "application_inactive",
              "number_not_found",
              "number_inactive",
              "number_not_on_application",
              "provider_unreachable"
            ]
          },
          "access": {
            "type": "string",
            "enum": [
              "owner",
              "granted"
            ]
          }
        }
      },
      "ProfilesResponse": {
        "type": "object",
        "required": [
          "ai_profiles",
          "telephony_profiles"
        ],
        "additionalProperties": false,
        "properties": {
          "ai_profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AIProfile"
            }
          },
          "telephony_profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TelephonyProfile"
            }
          }
        }
      },
      "CallDetails": {
        "type": "object",
        "required": [
          "max_duration_seconds",
          "record_requested",
          "record_effective"
        ],
        "additionalProperties": false,
        "properties": {
          "outcome_reason_code": {
            "type": "string"
          },
          "max_duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7200
          },
          "record_requested": {
            "type": "boolean"
          },
          "record_effective": {
            "type": "boolean"
          }
        }
      },
      "Call": {
        "type": "object",
        "required": [
          "call_id",
          "telephony_profile_id",
          "ai_profile_id",
          "to_number",
          "technical_status",
          "task_outcome",
          "details",
          "transcript_available",
          "recording_available",
          "created_at",
          "updated_at",
          "ended_at"
        ],
        "additionalProperties": false,
        "properties": {
          "call_id": {
            "type": "string"
          },
          "telephony_profile_id": {
            "type": "string"
          },
          "ai_profile_id": {
            "type": "string"
          },
          "to_number": {
            "type": "string"
          },
          "technical_status": {
            "$ref": "#/components/schemas/TechnicalStatus"
          },
          "task_outcome": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "success",
              "partial",
              "failed",
              "unknown",
              null
            ]
          },
          "details": {
            "$ref": "#/components/schemas/CallDetails"
          },
          "transcript_available": {
            "type": "boolean"
          },
          "recording_available": {
            "type": "boolean"
          },
          "created_at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "updated_at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "ended_at": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "CallsPage": {
        "type": "object",
        "required": [
          "calls",
          "next_cursor"
        ],
        "additionalProperties": false,
        "properties": {
          "calls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Call"
            }
          },
          "next_cursor": {
            "type": "string"
          }
        }
      },
      "CallStatus": {
        "type": "string",
        "enum": [
          "queued",
          "initiating",
          "ringing",
          "active",
          "ending",
          "ended",
          "failed"
        ]
      },
      "Speaker": {
        "type": "string",
        "enum": [
          "assistant",
          "callee",
          "system"
        ]
      },
      "Finality": {
        "type": "string",
        "enum": [
          "partial",
          "final"
        ]
      },
      "TranscriptTurn": {
        "type": "object",
        "required": [
          "seq",
          "speaker",
          "finality",
          "started_ms",
          "ended_ms",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "seq": {
            "type": "integer"
          },
          "speaker": {
            "$ref": "#/components/schemas/Speaker"
          },
          "finality": {
            "$ref": "#/components/schemas/Finality"
          },
          "started_ms": {
            "type": "integer",
            "minimum": 0
          },
          "ended_ms": {
            "type": [
              "integer",
              "null"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      },
      "TranscriptPage": {
        "type": "object",
        "required": [
          "call_id",
          "turns",
          "quality_flags",
          "next_cursor"
        ],
        "additionalProperties": false,
        "properties": {
          "call_id": {
            "type": "string"
          },
          "turns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranscriptTurn"
            }
          },
          "quality_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_cursor": {
            "type": "string"
          }
        }
      },
      "CreateCallRequest": {
        "type": "object",
        "required": [
          "profile_id",
          "to",
          "objective"
        ],
        "additionalProperties": false,
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\+[1-9][0-9]{6,14}$"
          },
          "recipient": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "maxLength": 35,
            "description": "BCP 47 language tag."
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "description": "Configurable server limit; oversized input is rejected, never truncated."
          },
          "instructions": {
            "type": "string",
            "description": "Configurable server limit; oversized input is rejected, never truncated. The limit applies to the full session text, so an oversize request is refused before queueing."
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fallbacks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "success_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "max_duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7200
          },
          "record": {
            "type": "boolean",
            "description": "Never enables recording unless the account owner has opted in through the WebGUI setting. Omission means no recording unless the per-user default policy enables it."
          }
        }
      },
      "CreatedCall": {
        "type": "object",
        "required": [
          "call_id",
          "status",
          "created_at"
        ],
        "additionalProperties": false,
        "properties": {
          "call_id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CallStatus"
          },
          "created_at": {
            "$ref": "#/components/schemas/Timestamp"
          }
        }
      },
      "RecordingStatus": {
        "type": "string",
        "enum": [
          "recording",
          "complete",
          "partial",
          "failed",
          "deleted"
        ]
      },
      "RecordingMetadata": {
        "type": "object",
        "required": [
          "call_id",
          "status",
          "content_type",
          "duration_ms",
          "byte_count",
          "download_path"
        ],
        "additionalProperties": false,
        "properties": {
          "call_id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RecordingStatus"
          },
          "content_type": {
            "const": "audio/wav"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0
          },
          "download_path": {
            "type": "string",
            "description": "Authenticated REST path, not a public URL."
          }
        }
      },
      "HangupResult": {
        "type": "object",
        "required": [
          "call_id",
          "technical_status",
          "task_outcome"
        ],
        "additionalProperties": false,
        "properties": {
          "call_id": {
            "type": "string"
          },
          "technical_status": {
            "$ref": "#/components/schemas/CallStatus"
          },
          "task_outcome": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "success",
              "partial",
              "failed",
              "unknown",
              null
            ]
          }
        }
      },
      "TelephonyProfileWrite": {
        "type": "object",
        "required": [
          "name",
          "caller_number",
          "api_key",
          "connection_id"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "caller_number": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{6,14}$"
          },
          "connection_id": {
            "type": "string",
            "maxLength": 128,
            "description": "Telnyx Call Control application id that calls dial through. Required.",
            "minLength": 1
          },
          "api_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "writeOnly": true,
            "description": "Write-only Telnyx API key."
          },
          "webhook_public_key": {
            "type": "string",
            "maxLength": 4096,
            "writeOnly": true,
            "description": "Write-only base64 Ed25519 webhook public key. Optional. Empty or omitted means no key."
          }
        }
      },
      "TelephonyProfileUpdate": {
        "type": "object",
        "required": [
          "name",
          "caller_number",
          "connection_id"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "caller_number": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{6,14}$"
          },
          "connection_id": {
            "type": "string",
            "maxLength": 128,
            "description": "Telnyx Call Control application id that calls dial through. Required.",
            "minLength": 1
          },
          "api_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "writeOnly": true,
            "description": "Write-only Telnyx API key. Optional on update: when omitted, the stored key is kept."
          },
          "webhook_public_key": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096,
            "writeOnly": true,
            "description": "Write-only base64 Ed25519 webhook public key. Omitted or empty keeps the stored key. JSON null removes the stored key. Not allowed on create."
          }
        }
      },
      "TelephonyProfileList": {
        "type": "object",
        "required": [
          "telephony_profiles"
        ],
        "additionalProperties": false,
        "properties": {
          "telephony_profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TelephonyProfile"
            }
          }
        }
      },
      "TelephonyValidation": {
        "type": "object",
        "required": [
          "profile_id",
          "connectivity_status",
          "connectivity_reason",
          "checked_at"
        ],
        "additionalProperties": false,
        "properties": {
          "profile_id": {
            "type": "string"
          },
          "connectivity_status": {
            "type": "string",
            "enum": [
              "verified",
              "failed"
            ]
          },
          "connectivity_reason": {
            "type": "string",
            "enum": [
              "",
              "secrets_unavailable",
              "invalid_credentials",
              "application_not_found",
              "application_inactive",
              "number_not_found",
              "number_inactive",
              "number_not_on_application",
              "provider_unreachable"
            ]
          },
          "checked_at": {
            "$ref": "#/components/schemas/Timestamp"
          }
        }
      },
      "TelephonyGrant": {
        "type": "object",
        "required": [
          "user_id",
          "granted_by",
          "created_at"
        ],
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string"
          },
          "granted_by": {
            "type": "string"
          },
          "created_at": {
            "$ref": "#/components/schemas/Timestamp"
          }
        }
      },
      "TelephonyGrantList": {
        "type": "object",
        "required": [
          "grants"
        ],
        "additionalProperties": false,
        "properties": {
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TelephonyGrant"
            }
          }
        }
      }
    }
  }
}
