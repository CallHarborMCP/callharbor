      "get": {
        "operationId": "getCallRecordingAudio",
        "summary": "Stream recording audio (planned)",
        "description": "Planned. Not mounted yet: the operation is not implemented. Requests return 404, or 405 when the path is mounted for another method. Streams audio/wav over authenticated REST. Supports single-range Range requests.",
        "x-callharbor-availability": "planned",
        "security": [
