{
  "openapi": "3.1.0",
  "info": {
    "title": "CallHarbor REST API",
    "version": "1.0.0",
    "description": "Versioned REST API v1. Every route requires a signed-in browser session. Identity comes only from that session; no route accepts a user or owner identifier. Timestamps are UTC RFC 3339 with a Z suffix. Only operations listed here are implemented."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/v1/profiles": {
      "get": {
        "operationId": "getProfiles",
        "summary": "List the caller's AI and telephony profiles",
        "description": "Returns non-secret profile fields only. Endpoint URLs, headers, instructions and secret references are never returned. Telephony connectivity_status is the last read-only validation result (unknown until a validation runs). access is owner or granted.",
        "responses": {
          "200": {
            "description": "Profiles owned by the caller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfilesResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/calls": {
      "get": {
        "operationId": "listCalls",
        "summary": "List the caller's calls, newest first",
        "description": "Keyset pagination over (created_at DESC, id DESC). Pass next_cursor back as cursor to read the next page. Cursors are opaque.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            },
            "description": "Opaque cursor from a previous next_cursor."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TechnicalStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of calls",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallsPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createCall",
        "summary": "Start a call",
        "description": "Queue one outbound call and return 202 with the queued call. The dial happens asynchronously in a bounded worker. Requires a session cookie with the CSRF token (403 forbidden on a bad token) and an Idempotency-Key header. Only a scoped OAuth token lacking mcp:call is refused 403 insufficient_scope; a browser session carries that scope. The same key with the same request returns the current call and its created_at; a different request under the same key is 409 idempotency_conflict. Refusals: invalid_input (400; malformed JSON, a body over 300 KiB, a missing Idempotency-Key, or out-of-range fields, including an E.164 to number); brief_too_large (the full session text, the AI profile's instructions with the brief and the callee notice, exceeds CALLHARBOR_MAX_CALL_BRIEF_BYTES; it is refused before queueing and never truncated); ai_profile_required (no AI profile is owned by the caller); ai_profile_ambiguous (more than one is owned; no request field selects one); not_found (unknown or ungranted telephony profile, with the same response for both); telephony_not_verified, telephony_connection_missing and telephony_webhook_key_missing (the profile is not ready for new calls); unavailable with reason calls_unavailable (HTTP 503) when the server is not running the call worker, because CALLHARBOR_PUBLIC_URL or the master key is missing. A refusal never writes a queued row.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Client-chosen key that makes a retried create return the same call.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Call queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedCall"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCallRequest"
              }
            }
          }
        }
      }
    },
