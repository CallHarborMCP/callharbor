{
  "server": "callharbor",
  "transport": "streamable-http",
  "endpoint": "/mcp",
  "authorization": "OAuth 2.1 bearer token; resource metadata at /.well-known/oauth-protected-resource/mcp",
  "errorResult": {
    "description": "A tool failure sets isError=true, leaves structuredContent unset, and returns one text content item whose text is the JSON envelope {\"error\":{\"code\",\"message\"}}. The code is one of the ErrorCode values in api/openapi.json. Cause is logged server-side and never returned.",
    "envelope": {
      "type": "object",
      "required": ["error"],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": ["unauthenticated", "forbidden", "insufficient_scope", "not_found", "invalid_input", "conflict", "unavailable", "internal"]
            },
            "message": { "type": "string" }
          }
        }
      }
    }
  },
  "tools": [
    {
      "name": "get_profiles",
      "status": "implemented",
      "scope": "mcp:read",
      "description": "Return the caller's AI profiles and the telephony profiles the caller owns or was granted, with non-secret fields only. Each telephony profile reports access (owner or granted) and its last connectivity result.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["ai_profiles", "telephony_profiles"],
        "additionalProperties": false,
        "properties": {
          "ai_profiles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "protocol", "primary_transport", "model", "voice"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "protocol": { "type": "string", "enum": ["realtime_ws", "live_ws"] },
                "primary_transport": { "type": "string", "enum": ["websocket"] },
                "model": { "type": "string" },
                "voice": { "type": "string" }
              }
            }
          },
          "telephony_profiles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "provider", "caller_number", "connectivity_status", "connectivity_reason", "access"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "provider": { "type": "string", "enum": ["telnyx"] },
                "caller_number": { "type": "string" },
                "connection_id": { "type": "string", "maxLength": 128 },
                "connectivity_status": { "type": "string", "enum": ["unknown", "verified", "failed"] },
                "connectivity_reason": { "type": "string", "enum": ["", "secrets_unavailable", "invalid_credentials", "application_not_found", "application_inactive", "number_not_found", "number_inactive", "number_not_on_application", "provider_unreachable"] },
                "access": { "type": "string", "enum": ["owner", "granted"] }
              }
            }
          }
        }
      },
      "readOnly": true
    },
    {
      "name": "list_calls",
      "status": "implemented",
      "scope": "mcp:read",
      "description": "List the caller's calls, newest first, one keyset page at a time.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "type": "string",
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": "string",
                "enum": ["queued", "initiating", "ringing", "active", "ending", "ended", "failed"]
              }
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["calls", "next_cursor"],
        "additionalProperties": false,
        "properties": {
          "calls": { "type": "array", "items": { "$ref": "#/$defs/call" } },
          "next_cursor": { "type": "string" }
        },
        "$defs": {
          "call": {
            "type": "object",
            "required": ["call_id", "telephony_profile_id", "ai_profile_id", "to_number", "technical_status", "task_outcome", "details", "transcript_available", "recording_available", "created_at", "updated_at", "ended_at"],
            "additionalProperties": false,
            "properties": {
              "call_id": { "type": "string" },
              "telephony_profile_id": { "type": "string" },
              "ai_profile_id": { "type": "string" },
              "to_number": { "type": "string" },
              "technical_status": { "type": "string", "enum": ["queued", "initiating", "ringing", "active", "ending", "ended", "failed"] },
              "task_outcome": { "type": ["string", "null"], "enum": ["success", "partial", "failed", "unknown", null] },
              "details": { "$ref": "#/$defs/callDetails" },
              "transcript_available": { "type": "boolean" },
              "recording_available": { "type": "boolean" },
              "created_at": { "type": "string", "format": "date-time" },
              "updated_at": { "type": "string", "format": "date-time" },
              "ended_at": { "type": ["string", "null"], "format": "date-time" }
            }
          },
          "callDetails": {
            "type": "object",
            "required": ["max_duration_seconds", "record_requested", "record_effective"],
            "additionalProperties": false,
            "properties": {
              "outcome_reason_code": { "type": "string" },
              "max_duration_seconds": { "type": "integer" },
              "record_requested": { "type": "boolean" },
              "record_effective": { "type": "boolean" }
            }
          }
        }
      },
      "readOnly": true
    },
    {
      "name": "get_call",
      "status": "implemented",
      "scope": "mcp:read",
      "description": "Return one call owned by the caller. Foreign or missing calls return not_found.",
      "inputSchema": {
        "type": "object",
        "required": ["call_id"],
        "additionalProperties": false,
        "properties": {
          "call_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["call_id", "telephony_profile_id", "ai_profile_id", "to_number", "technical_status", "task_outcome", "details", "transcript_available", "recording_available", "created_at", "updated_at", "ended_at"],
        "additionalProperties": false,
        "properties": {
          "call_id": { "type": "string" },
          "telephony_profile_id": { "type": "string" },
          "ai_profile_id": { "type": "string" },
          "to_number": { "type": "string" },
          "technical_status": { "type": "string", "enum": ["queued", "initiating", "ringing", "active", "ending", "ended", "failed"] },
          "task_outcome": { "type": ["string", "null"], "enum": ["success", "partial", "failed", "unknown", null] },
          "details": {
            "type": "object",
            "required": ["max_duration_seconds", "record_requested", "record_effective"],
            "additionalProperties": false,
            "properties": {
              "outcome_reason_code": { "type": "string" },
              "max_duration_seconds": { "type": "integer" },
              "record_requested": { "type": "boolean" },
              "record_effective": { "type": "boolean" }
            }
          },
          "transcript_available": { "type": "boolean" },
          "recording_available": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "readOnly": true
    },
    {
      "name": "make_call",
      "status": "implemented",
      "scope": "mcp:call",
      "description": "Queue one outbound AI voice call. Returns the queued call id at once; the dial happens asynchronously. Requires an idempotency_key: the same key with the same request returns the original call, and the same key with a different request is a conflict. The telephony profile must be verified and the caller must have exactly one AI profile.",
      "inputSchema": {
        "type": "object",
        "required": ["profile_id", "to", "objective", "idempotency_key"],
        "additionalProperties": false,
        "properties": {
          "profile_id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "to": { "type": "string", "minLength": 1, "pattern": "^\\+[1-9][0-9]{6,14}$" },
          "recipient": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "maxLength": 35, "description": "BCP 47 language tag." },
          "objective": { "type": "string", "minLength": 1 },
          "context": { "type": "string", "description": "Configurable server limit; oversized input is rejected, never truncated." },
          "instructions": { "type": "string", "description": "Configurable server limit; oversized input is rejected, never truncated. The limit applies to the full session text, so an oversize request is refused before queueing." },
          "constraints": { "type": "array", "items": { "type": "string" } },
          "fallbacks": { "type": "array", "items": { "type": "string" } },
          "success_criteria": { "type": "array", "items": { "type": "string" } },
          "max_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
          "record": {
            "type": "boolean",
            "description": "Optional per-call request. Never enables recording unless the account owner has opted in through the WebGUI setting. Omission means no recording unless the per-user default policy enables it. An owner-disabled setting is never bypassed."
          },
          "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["call_id", "status", "created_at"],
        "additionalProperties": false,
        "properties": {
          "call_id": { "type": "string" },
          "status": { "type": "string", "enum": ["queued", "initiating", "ringing", "active", "ending", "ended", "failed"] },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "name": "get_transcript",
      "status": "implemented",
      "scope": "mcp:read",
      "description": "Return one page of a call transcript owned by the caller, in seq order, up to 100 turns per page. Each turn carries its speaker, finality, timing, fidelity and provenance; unknown provenance is null. quality_flags lists the call's summary flags plus transcript_in_progress while the media run is open, transcript_not_finalized when the call has ended without a finalized summary, and no_media_session when the call never reached one. Other flags are open-ended; clients must accept values they do not know. Pass next_cursor back as cursor for the next page. Foreign or missing calls return not_found.",
      "inputSchema": {
        "type": "object",
        "required": ["call_id"],
        "additionalProperties": false,
        "properties": {
          "call_id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "cursor": { "type": "string", "maxLength": 512 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["call_id", "turns", "quality_flags", "finalized", "next_cursor"],
        "additionalProperties": false,
        "properties": {
          "call_id": { "type": "string" },
          "turns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["seq", "revision", "speaker", "finality", "started_ms", "ended_ms", "text", "fidelity", "timing_source", "source_ids", "correlation_id", "provider_item_id", "generated_ms", "played_ms", "played_is_estimate", "quality_flags"],
              "additionalProperties": false,
              "properties": {
                "seq": { "type": "integer", "minimum": 1 },
                "revision": { "type": "integer", "minimum": 1 },
                "speaker": { "type": "string", "enum": ["assistant", "callee", "system"] },
                "finality": { "type": "string", "enum": ["partial", "final"] },
                "started_ms": { "type": "integer", "minimum": 0 },
                "ended_ms": { "type": ["integer", "null"], "minimum": 0 },
                "text": { "type": "string" },
                "fidelity": { "type": "string", "enum": ["played", "interrupted_text_includes_unplayed", "playout_unconfirmed", "not_played", "provider_asr_approximate", "unavailable"] },
                "timing_source": { "type": "string", "enum": ["provider", "local_receive"] },
                "source_ids": { "type": "array", "items": { "type": "string" } },
                "correlation_id": { "type": ["string", "null"], "maxLength": 128 },
                "provider_item_id": { "type": ["string", "null"] },
                "generated_ms": { "type": ["integer", "null"], "minimum": 0 },
                "played_ms": { "type": ["integer", "null"], "minimum": 0 },
                "played_is_estimate": { "type": "boolean" },
                "quality_flags": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "quality_flags": { "type": "array", "items": { "type": "string" } },
          "finalized": { "type": "boolean" },
          "next_cursor": { "type": "string" }
        }
      },
      "readOnly": true
    },
    {
      "name": "get_recording",
      "status": "planned",
      "scope": "mcp:read",
      "description": "Planned. Not registered. Calling it returns an unknown-tool error. Returns metadata only; audio is read over authenticated REST.",
      "inputSchema": {
        "type": "object",
        "required": ["call_id"],
        "additionalProperties": false,
        "properties": {
          "call_id": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["call_id", "status", "content_type", "duration_ms", "byte_count", "download_path"],
        "additionalProperties": false,
        "properties": {
          "call_id": { "type": "string" },
          "status": { "type": "string", "enum": ["recording", "complete", "partial", "failed", "deleted"] },
          "content_type": { "const": "audio/wav" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "byte_count": { "type": "integer", "minimum": 0 },
          "download_path": { "type": "string", "description": "Authenticated REST path, not a public URL." }
        }
      }
    },
    {
      "name": "hangup_call",
      "status": "planned",
      "scope": "mcp:call",
      "description": "Planned. Not registered. Calling it returns an unknown-tool error and never ends a call.",
      "inputSchema": {
        "type": "object",
        "required": ["call_id"],
        "additionalProperties": false,
        "properties": {
          "call_id": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["call_id", "technical_status", "task_outcome"],
        "additionalProperties": false,
        "properties": {
          "call_id": { "type": "string" },
          "technical_status": { "type": "string", "enum": ["queued", "initiating", "ringing", "active", "ending", "ended", "failed"] },
          "task_outcome": { "type": ["string", "null"], "enum": ["success", "partial", "failed", "unknown", null] }
        }
      }
    }
  ]
}
