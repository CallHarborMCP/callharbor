              "format": "date-time",
              "type": "string"
            },
            "details": {
              "$ref": "#/$defs/callDetails"
            },
            "ended_at": {
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "recording_available": {
              "type": "boolean"
            },
            "task_outcome": {
              "enum": [
                "success",
                "partial",
                "failed",
                "unknown",
                null
              ],
              "type": [
