{
  "get_call": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "call_id"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "ai_profile_id": {
          "type": "string"
        },
        "call_id": {
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "details": {
          "additionalProperties": false,
          "properties": {
            "cost": {
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "pattern": "^[0-9]{1,12}(\\.[0-9]{1,6})?$",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "currency": {
                  "pattern": "^[A-Z]{3}$",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source": {
                  "enum": [
                    "provider",
                    "estimate",
                    null
                  ],
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "enum": [
                    "known",
                    "estimated",
                    "unavailable"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "status",
                "amount",
                "currency",
                "source"
              ],
              "type": "object"
            },
            "max_duration_seconds": {
              "type": "integer"
            },
            "outcome_reason_code": {
              "type": "string"
            },
            "record_effective": {
              "type": "boolean"
            },
            "record_requested": {
              "type": "boolean"
            },
            "task_assessment": {
              "additionalProperties": false,
              "properties": {
                "assessed_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "evidence": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "criterion": {
                        "maximum": 20,
                        "minimum": 1,
                        "type": "integer"
                      },
                      "fidelity": {
                        "type": "string"
                      },
                      "kind": {
                        "enum": [
                          "transcript_turn",
                          "call_event"
                        ],
                        "type": "string"
                      },
                      "met": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "seq": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "speaker": {
                        "enum": [
                          "assistant",
                          "callee",
                          "system"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "seq"
                    ],
                    "type": "object"
                  },
                  "maxItems": 32,
                  "type": "array"
                },
                "reason_codes": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "source": {
                  "enum": [
                    "technical",
                    "voice_session"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "reason_codes",
                "evidence",
                "source",
                "assessed_at"
              ],
              "type": [
                "object",
                "null"
              ]
            }
          },
          "required": [
            "max_duration_seconds",
            "record_requested",
            "record_effective",
            "cost",
            "task_assessment"
          ],
          "type": "object"
        },
        "ended_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "recording_available": {
          "type": "boolean"
        },
        "task_outcome": {
          "enum": [
            "success",
            "partial",
            "failed",
            "unknown",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "technical_status": {
          "enum": [
            "queued",
            "initiating",
            "ringing",
            "active",
            "ending",
            "ended",
            "failed"
          ],
          "type": "string"
        },
        "telephony_profile_id": {
          "type": "string"
        },
        "to_number": {
          "type": "string"
        },
        "transcript_available": {
          "type": "boolean"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "telephony_profile_id",
        "ai_profile_id",
        "to_number",
        "technical_status",
        "task_outcome",
        "details",
        "transcript_available",
        "recording_available",
        "created_at",
        "updated_at",
        "ended_at"
      ],
      "type": "object"
    }
  },
  "get_profiles": {
    "inputSchema": {
      "additionalProperties": false,
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "ai_profiles": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "primary_transport": {
                "enum": [
                  "websocket"
                ],
                "type": "string"
              },
              "protocol": {
                "enum": [
                  "realtime_ws",
                  "live_ws"
                ],
                "type": "string"
              },
              "voice": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "protocol",
              "primary_transport",
              "model",
              "voice"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "telephony_profiles": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "access": {
                "enum": [
                  "owner",
                  "granted"
                ],
                "type": "string"
              },
              "caller_number": {
                "type": "string"
              },
              "connection_id": {
                "maxLength": 128,
                "type": "string"
              },
              "connectivity_reason": {
                "enum": [
                  "",
                  "secrets_unavailable",
                  "invalid_credentials",
                  "application_not_found",
                  "application_inactive",
                  "number_not_found",
                  "number_inactive",
                  "number_not_on_application",
                  "provider_unreachable"
                ],
                "type": "string"
              },
              "connectivity_status": {
                "enum": [
                  "unknown",
                  "verified",
                  "failed"
                ],
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "provider": {
                "enum": [
                  "telnyx"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "provider",
              "caller_number",
              "connectivity_status",
              "connectivity_reason",
              "access"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "ai_profiles",
        "telephony_profiles"
      ],
      "type": "object"
    }
  },
  "get_recording": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "call_id"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "description": "Size of the WAV the audio endpoint serves: the 44-byte header plus the PCM bytes. 0 while the recording is in progress or when no audio was written.",
          "minimum": 0,
          "type": "integer"
        },
        "call_id": {
          "type": "string"
        },
        "channel_layout": {
          "description": "Channel 0 is the remote party and channel 1 the agent.",
          "items": {
            "enum": [
              "remote_party",
              "agent"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "channels": {
          "const": 2
        },
        "content_type": {
          "const": "audio/wav"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "download_path": {
          "description": "Authenticated REST path, not a public URL.",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "finalized_at": {
          "description": "Null until the recording is finalized.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "partial": {
          "description": "True unless status is complete.",
          "type": "boolean"
        },
        "quality_flags": {
          "description": "Why the audio may differ from the live call. Empty when none apply.",
          "items": {
            "enum": [
              "caller_gap_filled",
              "caller_frames_dropped",
              "agent_playout_estimated",
              "agent_interrupted",
              "agent_playout_unconfirmed",
              "write_failed",
              "backpressure",
              "recovered_after_restart"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "sample_rate": {
          "description": "Sample rate of both channels, in hertz. 0 until the writer has fixed the format.",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "enum": [
            "recording",
            "complete",
            "partial",
            "failed",
            "deleted"
          ],
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "status",
        "content_type",
        "duration_ms",
        "byte_count",
        "download_path",
        "sample_rate",
        "channels",
        "channel_layout",
        "quality_flags",
        "partial",
        "created_at",
        "finalized_at"
      ],
      "type": "object"
    }
  },
  "get_transcript": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "cursor": {
          "maxLength": 512,
          "type": "string"
        }
      },
      "required": [
        "call_id"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "type": "string"
        },
        "finalized": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": "string"
        },
        "quality_flags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "turns": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "correlation_id": {
                "maxLength": 128,
                "type": [
                  "string",
                  "null"
                ]
              },
              "ended_ms": {
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "fidelity": {
                "enum": [
                  "played",
                  "interrupted_text_includes_unplayed",
                  "playout_unconfirmed",
                  "not_played",
                  "provider_asr_approximate",
                  "unavailable"
                ],
                "type": "string"
              },
              "finality": {
                "enum": [
                  "partial",
                  "final"
                ],
                "type": "string"
              },
              "generated_ms": {
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "played_is_estimate": {
                "type": "boolean"
              },
              "played_ms": {
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "provider_item_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "quality_flags": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "revision": {
                "minimum": 1,
                "type": "integer"
              },
              "seq": {
                "minimum": 1,
                "type": "integer"
              },
              "source_ids": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "speaker": {
                "enum": [
                  "assistant",
                  "callee",
                  "system"
                ],
                "type": "string"
              },
              "started_ms": {
                "minimum": 0,
                "type": "integer"
              },
              "text": {
                "type": "string"
              },
              "timing_source": {
                "enum": [
                  "provider",
                  "local_receive"
                ],
                "type": "string"
              }
            },
            "required": [
              "seq",
              "revision",
              "speaker",
              "finality",
              "started_ms",
              "ended_ms",
              "text",
              "fidelity",
              "timing_source",
              "source_ids",
              "correlation_id",
              "provider_item_id",
              "generated_ms",
              "played_ms",
              "played_is_estimate",
              "quality_flags"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "call_id",
        "turns",
        "quality_flags",
        "finalized",
        "next_cursor"
      ],
      "type": "object"
    }
  },
