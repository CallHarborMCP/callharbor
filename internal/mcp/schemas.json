            },
            "telephony_profile_id": {
              "type": "string"
            },
            "to_number": {
              "type": "string"
            },
            "transcript_available": {
              "type": "boolean"
            },
            "updated_at": {
              "format": "date-time",
              "type": "string"
            }
          },
          "required": [
            "call_id",
            "telephony_profile_id",
            "ai_profile_id",
            "to_number",
            "technical_status",
            "task_outcome",
            "details",
            "transcript_available",
            "recording_available",
            "created_at",
            "updated_at",
            "ended_at"
          ],
          "type": "object"
        },
        "callDetails": {
          "additionalProperties": false,
          "properties": {
            "cost": {
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "pattern": "^[0-9]{1,12}(\\.[0-9]{1,6})?$",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "currency": {
                  "pattern": "^[A-Z]{3}$",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source": {
                  "enum": [
                    "provider",
                    "estimate",
                    null
                  ],
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "enum": [
                    "known",
                    "estimated",
                    "unavailable"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "status",
                "amount",
                "currency",
                "source"
              ],
              "type": "object"
            },
            "max_duration_seconds": {
              "type": "integer"
            },
            "outcome_reason_code": {
              "type": "string"
            },
            "record_effective": {
              "type": "boolean"
            },
            "record_requested": {
              "type": "boolean"
            },
