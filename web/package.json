{
  "name": "callharbor-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript7/bin/tsc -b && vite build",
    "preview": "vite preview --strictPort --port 4173",
    "typecheck": "node ./node_modules/typescript7/bin/tsc -b",
    "lint": "eslint .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.74.0",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
